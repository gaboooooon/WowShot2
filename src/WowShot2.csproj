<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 混在DPI環境（例: 4K@150% + 2K@125%）でキャプチャ座標を物理ピクセルに一致させるため
         Per-Monitor V2 を必須とする。既定の SystemAware ではプライマリのDPI換算座標が返り、
         画面DC（BitBlt元）の物理座標とズレて画像の端が欠落する。 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationTitle>WowShot2</ApplicationTitle>
    <AssemblyTitle>WowShot2</AssemblyTitle>
    <Product>WowShot2</Product>
    <Company>Gaboooooon</Company>
    <Authors>Gaboooooon</Authors>
    <Description>Windows用 高機能キャプチャツール</Description>
    <Copyright>© 2026 Gaboooooon</Copyright>
    <Version>1.0.5</Version>
    <AssemblyVersion>1.0.5.0</AssemblyVersion>
    <FileVersion>1.0.5.0</FileVersion>
    <ApplicationIcon>WowShot2.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="WowShot2.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resource.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resource.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>